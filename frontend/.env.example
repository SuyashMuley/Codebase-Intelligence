# Where the Next.js server proxies /api. Read when the app is BUILT (next.config.ts rewrites), so on
# Vercel set it as a project environment variable before the first deploy and redeploy after any
# change. Locally the default is http://localhost:8000.
BACKEND_URL=http://localhost:8000

# Content-Security-Policy mode (read at request time): enforce (default), report-only (the browser
# reports violations in its console but blocks nothing; for rolling out a change) or off.
# CSP_MODE=enforce
