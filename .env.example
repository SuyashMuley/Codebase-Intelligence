# Copy to backend/.env for local runs outside Docker. Never commit real values.

ENVIRONMENT=development
LOG_LEVEL=INFO

# App connection. On Neon use the POOLED endpoint (host contains "-pooler").
DATABASE_URL=postgresql+psycopg://cip:cip@localhost:5432/cip
# Migrations on Neon must use the DIRECT endpoint. Leave empty locally.
ALEMBIC_DATABASE_URL=
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# Comma-separated browser origins allowed to call the API. No wildcard.
CORS_ORIGINS=http://localhost:3000

# Used by later milestones (not read yet):
# GITHUB_TOKEN=
# OPENROUTER_API_KEY=
# HF_TOKEN=
