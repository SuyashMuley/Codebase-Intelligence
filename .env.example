# Where this file goes: either of these works, and backend/.env wins if both exist.
#   .env           (repo root)  also used by docker compose, which passes it to the container
#   backend/.env   when you run the API directly (uv run uvicorn ...)
# The API must be restarted after you edit it. Never commit real values; both are gitignored.

ENVIRONMENT=development
LOG_LEVEL=INFO

# App connection. On Neon use the POOLED endpoint (host contains "-pooler").
DATABASE_URL=
# Migrations on Neon must use the DIRECT endpoint. Leave empty locally.
ALEMBIC_DATABASE_URL=
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# Comma-separated browser origins allowed to call the API. No wildcard.
CORS_ORIGINS=http://localhost:3000

# --- Sign in with GitHub (REQUIRED: the API refuses to start in production without these) ---
# Create the GitHub App first: see docs/GITHUB_APP_SETUP.md
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Public URL of the FRONTEND, no trailing slash. The OAuth callback and post-login redirects
# use it. Local: http://localhost:3000   Production: your Vercel URL.
APP_BASE_URL=http://localhost:3000
# Signs the short-lived login state cookie. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Encrypts GitHub tokens at rest (32 random bytes, url-safe base64). Generate:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Changing it later signs every user out, because stored tokens can no longer be decrypted.
TOKEN_ENCRYPTION_KEY=
# Local http://localhost does not always accept Secure cookies (Safari); set false for local
# dev only. Must be true in production.
COOKIE_SECURE=false
# SESSION_ABSOLUTE_DAYS=14
# SESSION_IDLE_HOURS=24

# --- GitHub API token (optional fallback) ---
# From M3 each signed-in user's own token is used. This platform token is only a fallback for
# requests without one. A fine-grained token with NO permissions raises the limit from 60 to
# 5,000 requests/hour: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# --- Ingestion limits (defaults shown; tune for your free-tier budget) ---
# MAX_TARBALL_BYTES=26214400
# MAX_FILES=2000
# MAX_TOTAL_SOURCE_BYTES=5242880
# MAX_FILE_BYTES=262144
# INGESTIONS_PER_CLIENT_PER_DAY=10

# --- Rate limiting / client identity ---
# Salt for hashing client IPs into quota keys. Set a long random value in production.
CLIENT_KEY_SALT=dev-salt-change-me
# Number of trusted proxies in front of the API. 0 locally; 1 on Render.
FORWARDED_FOR_HOPS=0
# Per signed-in user:
# RATE_LIMIT_PER_MINUTE=120
# INDEX_RATE_LIMIT_PER_MINUTE=10
# Per IP (backstop on all /api routes, and on the sign-in endpoints):
# IP_RATE_LIMIT_PER_MINUTE=600
# AUTH_RATE_LIMIT_PER_MINUTE=30

# --- Frontend (frontend/.env.local) ---
# Where the Next.js server proxies /api to. Local: http://localhost:8000
# BACKEND_URL=http://localhost:8000

# --- Embeddings (search) ---
# "cloudflare" = Workers AI bge-small-en-v1.5 (free tier, about 10,000 neurons/day, roughly
# 11,000 chunks/day). Create an API token with the "Workers AI" permission:
# https://dash.cloudflare.com/profile/api-tokens ; account id is on the dashboard overview.
# "hash" = offline lexical embedder for demos/tests (no meaning-based search).
EMBEDDING_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# SEARCH_RATE_LIMIT_PER_MINUTE=20

# --- Chat model (OpenRouter): AI review of change impact now, question answering in M7 ---
# Key: https://openrouter.ai/settings/keys (a free key works with ":free" models).
OPENROUTER_API_KEY=
# Free models come and go and are often slow, empty or rate limited upstream. These two worked
# in a check on this project's prompts; "openrouter/free" picks whichever is answering. The
# fallback is tried once on failure.
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_FALLBACK_MODEL=baidu/ernie-5.5-flash-preview:free
# One call, fallback included, must finish inside this many seconds (the browser's proxy gives
# up at about 30).
# LLM_BUDGET_SECONDS=28
# AI_RATE_LIMIT_PER_MINUTE=5
# "low" asks reasoning models to think briefly: faster, fewer empty replies. Blank to omit.
# OPENROUTER_REASONING_EFFORT=low

# --- A second chat provider as a fallback (optional): Groq, which has a free tier ---
# When OpenRouter is rate limited, down or out of credit, requests go to Groq, and OpenRouter is
# then left alone for as long as it asked (its own "try again at" hint) or a default (a minute
# for a rate limit, 30 s for an outage, 10 min for a rejected key), instead of failing every
# request. Used for PUBLIC repositories only: a private repository's code only ever goes to its
# owner's own provider. Key: https://console.groq.com/keys . Chat only: Groq has no embeddings model.
# Groq's published table (console.groq.com/docs/rate-limits, read 2026-11-18; it is headed "base
# limits for the Developer plan", your free plan's own numbers are in console.groq.com/settings/limits)
# gives openai/gpt-oss-120b, openai/gpt-oss-20b and qwen/qwen3.8-27b: 30 requests/min, 1,000/day,
# 8,000 tokens/min, 200,000 tokens/day, per organisation (so shared by everyone using the platform).
# GROQ_API_KEY=
# Must be a model Groq offers right now; the list changes. This one was on that table.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=
# The gpt-oss models take a flat reasoning_effort (low, medium, high); sent with include_reasoning
# false so the thinking is not returned. Blank to send neither (use blank for a model that does not
# take them; qwen's values differ).
# GROQ_REASONING_EFFORT=low
# A request estimated above this many tokens (prompt at about 3 characters a token, plus the reply
# allowance) cannot succeed on Groq, so it is not sent there. 0 turns the check off.
# GROQ_TOKENS_PER_MINUTE=8000
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# The order providers are tried in. A provider with no key is skipped.
# LLM_PROVIDER_ORDER=openrouter,groq

# --- Asking questions (chat) ---
# CHAT_BUDGET_SECONDS=28
# CHAT_RATE_LIMIT_PER_MINUTE=5
# Model-backed questions per user per repository per day. Declined questions are free.
# CHAT_DAILY_LIMIT=25
# Similarity below which nothing counts as relevant. Calibrated for bge-small-en-v1.5; another
# embedding model needs its own value (python -m eval.qa_eval).
# QA_MIN_SIMILARITY=0  # 0 = ask the model anything; e.g. 0.7 refuses distant questions without a model call

# --- Private repositories (M9) ---
# The GitHub App's URL name (github.com/apps/<slug>). Only used to show an "install the app" link.
# GITHUB_APP_SLUG=
# How long GitHub's confirmation that you can still see a private repository is reused. It is the
# longest a revoked repository stays reachable. Lower is stricter and uses more GitHub API calls.
# PRIVATE_ACCESS_RECHECK_SECONDS=300

# --- Metrics and health (optional) ---
# Lets a monitoring system read GET /metrics (API and worker) with this bearer token. Unset: the
# endpoint does not exist. Metrics are counts and timings, never contents. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# METRICS_TOKEN=
# The worker's own HTTP server: /health (is its loop turning?) and /metrics. Off unless a port is
# set. Binds to localhost; use 0.0.0.0 inside a container.
# WORKER_HTTP_PORT=9100
# WORKER_HTTP_HOST=127.0.0.1
# /health reports unhealthy if the worker's loop has not turned for this many seconds.
# WORKER_HEALTH_STALE_SECONDS=120

# --- Background worker (python -m app.worker; optional, see docs/DEPLOYMENT.md) ---
# Seconds to sleep when there is no work.
# WORKER_POLL_SECONDS=2
# A job the worker cannot run by itself (its owner keeps the key in a browser, has no provider, or
# lost access) is left alone this long, then looked at again.
# WORKER_SKIP_SECONDS=60

# Private snapshots (files, chunks, vectors, graph) are deleted this many days after indexing.
# 0 keeps them until the repository is disconnected. Public snapshots never expire.
# PRIVATE_RETENTION_DAYS=30
# Audit events (who used a private repository, never what was in it) are deleted after this many
# days by the same scheduled purge. 0 keeps them forever.
# AUDIT_RETENTION_DAYS=365
# Lets a scheduler call POST /api/internal/purge-expired (see .github/workflows/purge-private-data.yml).
# Unset, that endpoint does not exist. Expiry is also enforced whenever a private repository is used.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# MAINTENANCE_TOKEN=
